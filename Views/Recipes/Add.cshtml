@model RecipeSharingSystem.Models.Recipe

<h2>Add a Recipe</h2>

<form asp-action="Add" method="post">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

<hr />

<h2>My Recipes</h2>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Created By</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@{
    var userName = User.Identity?.Name;
    var recipes = ViewBag.Recipes as List<RecipeSharingSystem.Models.Recipe>;
    if (recipes != null)
    {
        foreach (var recipe in recipes.Where(r => r.AuthorUsername == userName))
        {
            <tr>
                <td>@recipe.Title</td>
                <td>@recipe.Description</td>
                <td>@recipe.AuthorUsername</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@recipe.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this recipe?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
}
    </tbody>
</table>