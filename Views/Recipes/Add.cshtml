@model RecipeSharingSystem.Models.Recipe

<h2>Add a Recipe</h2>

<form asp-action="Add" method="post">
    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

<hr />

<h2>All Recipes</h2>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Created By</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@{
    var userName = User.Identity?.Name;
    var recipes = ViewBag.Recipes as List<RecipeSharingSystem.Models.Recipe>;
    if (recipes != null)
    {
        foreach (var recipe in recipes)
        {
            <tr>
                <td>@recipe.Title</td>
                <td>@recipe.Description</td>
                <td>@recipe.AuthorUsername</td>
                <td>
                    @if (recipe.AuthorUsername == userName)
                    {
                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    }
}
    </tbody>
</table>