@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card">
    <div class="card-body">
        <h1 class="card-title">@ViewData["Title"]</h1>
        <p class="card-text">
            We respect your privacy. When you register or share recipes on our site, we may collect basic
            information like your name and email to provide a better experience.
            We don’t sell your data to anyone. Cookies may be used to improve website functionality.
            By using our site, you agree to this simple privacy policy.
        </p>
    </div>
</div>
