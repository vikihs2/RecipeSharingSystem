@{
    ViewData["Title"] = "About";
}

<div class="container py-5">
    <h2 class="fw-bold text-center mb-2" style="color: #7a3b13;">About TastyTales</h2>
    <p class="lead text-center mb-5" style="color: #a14517;">
        We're passionate about bringing food lovers together to share their culinary stories and discover amazing recipes from around the world.
    </p>
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h4 class="fw-bold mb-2" style="color: #a14517;">Our Story</h4>
            <p style="color: #7a3b13;">
                TastyTales was born from a simple idea: everyone has a story to tell through food. Whether it's a family recipe passed down through generations or a creative new dish you've discovered, every recipe has a tale worth sharing.
            </p>
            <p style="color: #7a3b13;">
                Our platform brings together home cooks, professional chefs, and food enthusiasts to create a vibrant community where culinary creativity knows no bounds.
            </p>
        </div>
        <div class="col-md-6 text-center">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=500&q=80" alt="Cooking together" class="img-fluid rounded" style="max-height: 320px; object-fit: cover;">
        </div>
    </div>
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-3">
            <div class="p-4 rounded" style="background: #fff6e0;">
                <div style="font-size: 2em; color: #a14517;"><i class="bi bi-search"></i> <span style="background: #fca311; color: #fff; border-radius: 8px; padding: 0.2em 0.5em;"><i class="bi bi-search"></i></span></div>
                <h5 class="fw-bold mt-3" style="color: #a14517;">Share Recipes</h5>
                <p style="color: #7a3b13;">Upload your favorite recipes with photos and detailed instructions to inspire others.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="p-4 rounded" style="background: #fff6e0;">
                <div style="font-size: 2em; color: #a14517;"><span style="background: #fca311; color: #fff; border-radius: 8px; padding: 0.2em 0.5em;"><i class="bi bi-people"></i></span></div>
                <h5 class="fw-bold mt-3" style="color: #a14517;">Build Community</h5>
                <p style="color: #7a3b13;">Connect with fellow food lovers and discover new culinary traditions from around the world.</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="p-4 rounded" style="background: #fff6e0;">
                <div style="font-size: 2em; color: #a14517;"><span style="background: #fca311; color: #fff; border-radius: 8px; padding: 0.2em 0.5em;"><i class="bi bi-lightbulb"></i></span></div>
                <h5 class="fw-bold mt-3" style="color: #a14517;">Get Inspired</h5>
                <p style="color: #7a3b13;">Explore thousands of recipes and find your next favorite dish to cook and share.</p>
            </div>
        </div>
    </div>
    <div class="rounded p-4 text-center" style="background: #fff6e0;">
        <h4 class="fw-bold mb-2" style="color: #a14517;">Join Our Culinary Journey</h4>
        <p style="color: #7a3b13;">
            Ready to share your culinary story? Join thousands of food lovers who have already made TastyTales their home for recipe sharing and discovery.
        </p>
    </div>
</div>