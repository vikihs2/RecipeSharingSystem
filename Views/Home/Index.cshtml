@model IEnumerable<RecipeSharingSystem.Models.Recipe>

@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">Welcome to Recipe Sharing System</h1>
        <p class="col-md-8 fs-4">Discover and share your favorite recipes with others.</p>
    </div>
</div>

<section>
    <h2 class="mb-4">Latest Recipes</h2>

    @if (!Model.Any())
    {
        <p class="text-muted">No recipes have been added yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var recipe in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@recipe.Title</h5>
                            <p class="card-text">@recipe.Description</p>
                        </div>
                        <div class="card-footer text-muted">
                            Posted by @recipe.AuthorUsername on @recipe.CreatedOn.ToShortDateString()
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
