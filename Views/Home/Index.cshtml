@model IEnumerable<RecipeSharingSystem.Models.Recipe>

@functions {
    public string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Desserts" => "🍰",
            "Main Dishes" => "🍝",
            "Salads" => "🥗",
            "Appetizers" => "🍞",
            "Soups & Stews" => "🍲",
            "Breakfast" => "🥐",
            "Vegetarian / Vegan" => "🌱",
            _ => ""
        };
    }
}

@{
    ViewData["Title"] = "Home Page";
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger text-center">@ViewBag.ErrorMessage</div>
}

<div class="py-5" style="background: linear-gradient(180deg, #fffbe6 0%, #fff6e0 100%);">
    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-3" style="color: #7a3b13;">
            Discover Amazing <span style="color: #fc8e11;">Recipes</span>
        </h1>
        <p class="lead mb-4" style="color: #a14517;">
            Share your culinary creations and discover delicious recipes from food lovers around the world. Join our community of passionate cooks today!
        </p>
        <form class="d-flex justify-content-center mb-4" method="get" action="@Url.Action("Index", "Home")">
            <input class="form-control w-50 me-2" type="search" name="category" placeholder="🔍 Search recipes..." aria-label="Search" style="max-width: 400px; border-radius: 12px;">
            <button type="submit" class="btn-sighnIn">Search</button>
        </form>
    </div>
</div>

<section class="container my-5">
    <h2 class="mb-3 text-center fw-bold" style="color: #7a3b13;">Featured Recipes</h2>
    <p class="text-center mb-5" style="color: #a14517;">Discover our handpicked selection of amazing recipes that will inspire your next culinary adventure.</p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var recipe in Model.Take(4))
        {
            var displayName = recipe.AuthorUsername?.Contains("@") == true ? recipe.AuthorUsername.Split('@')[0] : recipe.AuthorUsername;
            var isLong = !string.IsNullOrEmpty(recipe.Description) && recipe.Description.Length > 100;
            var shortDesc = isLong ? recipe.Description.Substring(0, 100) + "..." : recipe.Description;
            <div class="col">
                <div class="card h-100 shadow-sm custom-recipe-card">
                    <img src="@(string.IsNullOrEmpty(recipe.PhotoUrl) ? "https://source.unsplash.com/400x200/?food,recipe," + recipe.Title : recipe.PhotoUrl)" class="card-img-top" alt="Recipe image">
                    <div class="card-body">
                        <span class="badge rounded-pill" style="background: #ffe5c2; color: #a14517; font-weight: bold;">
                            @GetCategoryIcon(recipe.Category) @recipe.Category
                        </span>
                        <h5 class="card-title fw-bold" style="color: #a14517;">@recipe.Title</h5>
                        <p class="card-text" id="desc-short-@recipe.Id" style="display:block;">
                            @shortDesc
                            @if (isLong)
                            {
                                <button type="button" class="btn-sighnIn btn-sm ms-2" onclick="showFullDesc(@recipe.Id)">Show All</button>
                            }
                        </p>
                        <p class="card-text" id="desc-full-@recipe.Id" style="display:none;">
                            @recipe.Description
                            <button type="button" class="btn-sighnIn btn-sm ms-2" onclick="hideFullDesc(@recipe.Id)">Show Less</button>
                        </p>
                        <div class="d-flex gap-3 mt-3 mb-2" style="color: #a14517;">
                            <span>⏱ @recipe.TimeToMake minutes</span>
                            <span>👤 @recipe.Servings servings</span>
                        </div>
                    </div>
                    <div class="card-footer text-muted small" style="background: #fff8e6;">
                        By @displayName • @recipe.CreatedOn.ToShortDateString()
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "AllRecipes")" class="btn-sighnIn px-5 py-2 fw-semibold">View All Recipes</a>
    </div>
</section>

<section class="py-5" style="background: linear-gradient(90deg, #fffbe6 0%, #fff6e0 100%);">
    <div class="container text-center">
        <h2 class="fw-bold mb-3" style="color: #a14517;">Join Our Community</h2>
        <p class="lead mb-4" style="color: #7a3b13;">Sign up to share your favorite recipes, comment on others, and become part of our growing food-loving family!</p>
        <a href="@Url.Action("Register", "User")" class="btn-sighnIn btn-lg px-5">Get Started</a>
    </div>
</section>

<script>
function showFullDesc(id) {
    document.getElementById('desc-short-' + id).style.display = 'none';
    document.getElementById('desc-full-' + id).style.display = 'block';
}
function hideFullDesc(id) {
    document.getElementById('desc-short-' + id).style.display = 'block';
    document.getElementById('desc-full-' + id).style.display = 'none';
}
</script>