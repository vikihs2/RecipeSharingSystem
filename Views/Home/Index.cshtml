@model IEnumerable<RecipeSharingSystem.Models.Recipe>

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/site.css" />

<header>
    <div class="welcome-box">
        <h1>Welcome to Recipe Sharing System</h1>
    </div>
</header>

<main>
    <section>
        <h2 class="main-heading">Latest Recipes</h2>

        @if (!Model.Any())
        {
            <p>No recipes have been added yet.</p>
        }
        else
        {
            @foreach (var recipe in Model)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">@recipe.Title</h5>
                        <p class="card-text">@recipe.Description</p>
                        <p class="text-muted">
                            Posted by @recipe.AuthorUsername on @recipe.CreatedOn.ToShortDateString()
                        </p>
                    </div>
                </div>
            }
        }
    </section>
</main>