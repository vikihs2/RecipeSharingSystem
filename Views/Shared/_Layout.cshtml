<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Recipe Sharing System</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg" style="background: #fff6e0; border-bottom: 1px solid #fca311;">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="@Url.Action("Index", "Home")" style="color: #a14517; font-size: 1.7rem;">
                <span style="background: #fc8e11; color: #fff; border-radius: 12px; padding: 0.3em 0.7em; font-weight: bold; font-size: 1.3em; margin-right: 0.5em;">R</span>
                TastyRecipes
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: #a14517;" href="@Url.Action("Index", "Home")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: #a14517;" href="@Url.Action("Index", "AllRecipes")">Recipes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" style="color: #a14517;" href="#">Categories</a>
                    </li>
                    <li class="nav-item">
    <a class="nav-link fw-semibold" style="color: #a14517;" href="@Url.Action("About", "Home")">About</a>
</li>
                </ul>
                <ul class="navbar-nav mb-2 mb-lg-0 d-flex align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <a class="nav-link fw-semibold" style="color: #a14517;" asp-controller="Recipes" asp-action="Add">Add Recipe</a>
        </li>
        <li class="nav-item">
            <form method="post" asp-controller="User" asp-action="Logout" class="d-inline m-0 p-0">
                <button type="submit" class="nav-link btn btn-link fw-semibold p-0 m-0" style="color: #a14517; background: none; border: none;">Logout</button>
            </form>
        </li>
    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-warning fw-semibold ms-2" style="border-width:2px; color:#fca311; border-color:#fca311;" href="@Url.Action("Login", "User")">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" style="color: #a14517;" href="@Url.Action("Register", "User")">Register</a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
{
    <li class="nav-item">
        <a class="nav-link fw-semibold" style="color: #a14517;" href="@Url.Action("AdminPanel", "Admin")">Admin Panel</a>
    </li>
}
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

<footer class="footer-modern mt-auto pt-5 pb-4" style="background: #a14517;">
    <div class="container">
        <div class="row text-white">
            <div class="col-md-4 mb-3">
                <div class="d-flex align-items-center mb-2">
                    <span style="background:#fc8e11;color:#fff;border-radius:10px;padding:0.4em 0.8em;font-weight:bold;font-size:1.5em;display:inline-block;margin-right:0.5em;">R</span>
                    <span style="font-size:1.5em;font-weight:bold;">TastyRecipes</span>
                </div>
                <p>Join our community of passionate food lovers and discover amazing recipes from around the world. Share your culinary adventures with us!</p>
                <p class="mb-0" style="color:#ffbfae;">Made with <span style="color:#fca311;">&#10084;</span> for food lovers everywhere</p>
            </div>
            <div class="col-md-4 mb-3">
                <h5 class="fw-bold">Quick Links</h5>
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("Index", "Home")" class="footer-link">Home</a></li>
                    <li><a href="@Url.Action("Index", "AllRecipes")" class="footer-link">All Recipes</a></li>
                    <li><a href="@Url.Action("Index", "Categories")" class="footer-link">Categories</a></li> <!--add Categories page-->
                </ul>
            </div>
            <div class="col-md-4 mb-3">
                <h5 class="fw-bold">Legal</h5>
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("Index", "Privacy")" class="footer-link">Privacy Policy</a></li>
                    <li><a href="@Url.Action("Index", "Contacts")" class="footer-link">Contact</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>