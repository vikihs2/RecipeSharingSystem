@{
    ViewData["Title"] = "Admin Panel";
}

<h2>Admin Panel</h2>

<div class="mb-4">
    <h4>🗂️ Manage Recipes</h4>
    <ul>
        <li>Approve or Reject recipes submitted by users before they go live.</li>
        <li>Edit/Delete any recipe, including user-submitted ones.</li>
        <li>Feature recipes to promote them on the homepage.</li>
    </ul>
</div>
<div class="mb-4">
    <h4>👥 Manage Users</h4>
    <ul>
        <li>View a list of all registered users.</li>
        <li>Block or delete users if necessary (e.g., abusive content).</li>
        <li>Upgrade users to moderators (optional).</li>
    </ul>
</div>
<div class="mb-4">
    <h4>🏷️ Manage Categories & Tags</h4>
    <ul>
        <li>Create, edit, or delete recipe categories (e.g., Breakfast, Vegan, Desserts).</li>
        <li>Manage tags (like “Quick”, “Spicy”, “Gluten-Free”).</li>
    </ul>
</div>
<div class="mb-4">
    <h4>💬 Moderate Comments</h4>
    <ul>
        <li>Delete inappropriate comments.</li>
    </ul>
</div>
<div class="mb-4">
    <h4>📊 Site Statistics</h4>
    <ul>
        <li>Total users</li>
        <li>Total recipes</li>
        <li>Most liked/viewed recipes</li>
        <li>Top contributors</li>
    </ul>
</div>
<div class="mb-4">
    <h4>⚙️ System Settings</h4>
    <ul>
        <li>Change site-wide settings like welcome message, homepage banner text/image.</li>
        <li>Enable/disable recipe submissions.</li>
    </ul>
</div>